__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.env
.env.*
!.env.example
docker-compose.override.yml
!deploy/.env.example
.pytest_cache/
.ruff_cache/
.claude/
chat/
*.log
rendered.docx
rendered_*.docx

# --- Submission video build artifacts ---------------------------------------
# Voice-over audio, Playwright captures, per-beat segments, final master.
# Regenerated by scripts/generate_voiceover.py + scripts/record_demo.py +
# scripts/assemble_video.sh. Keep out of git — large binaries, easy to rebuild.
assets/video/audio/
# Kept because .gitignore has always covered audio/, so the ElevenLabs cut
# existed in exactly one place on disk. Back it up before re-rendering.
assets/video/audio-elevenlabs-backup/
assets/video/captures/
assets/video/segments/
assets/video/*.mp4

# --- Prod / deploy secrets and local state -----------------------------------
# Never commit real prod compose overlays, tunnel configs, or credential files.
deploy/.env
deploy/.env.local
deploy/.env.prod
deploy/*.local.yml
deploy/secrets/
deploy/*.pem
deploy/*.key
deploy/*.crt
deploy/*.p12
*.tar.gz.enc
credentials.json
service-account*.json
cloudflared-*.json
*.tunnel.json
id_rsa
id_ed25519
*.pk8
known_hosts

# Tailwind: standalone CLI binary and the compiled bundle. The bundle is
# regenerated by `scripts/build-css.{ps1,sh}` for dev and by the Dockerfile's
# css-builder stage for production images.
.tailwind/
src/docgen/ui/static/app.css

# Smoke-test scratch output — rendered PDFs, sample payloads, etc.
scripts/_smoke_out/

# Local submission video (28MB, not tracked; served via /static)
src/docgen/ui/static/verdikt-submission.mp4
# Parked HeyGen voice-clone render (see docs/demo-scripts/voice-choice.md).
assets/video/audio-heygen-unused/

# --- Local scratch and superseded drafts (never part of the submission) ------
.tmp/
tmp/
assets/video/screenshots/
reports/bucket-*.xml
reports/results.xml
reports/test-report*.xlsx
# Current deck and one-slide are docs/verdikt-judges-deck.pdf and docs/verdikt-one-slide.pdf; older drafts stay local.
docs/verdikt-judges-deck-v2.pdf
docs/verdikt-judges-deck-v3.pdf
# Generated by scripts/browser_e2e.py; screenshots can show test keys, so keep them out of git.
reports/e2e-shots/
# Devpost staging video (19MB, rebuilt by scripts/build_submission.sh).
submission/video/*.mp4
# Build staging dir, swapped into submission/ at the end of the build.
submission.new/
submission.old.*/
