# ============================================================
# DocGen / Quire — environment configuration
# ============================================================
# Copy this file to `.env` at the repo root and fill in the blanks.
# `docker compose --env-file .env ...` will pick it up. On any host
# handling real data, restrict permissions on the copy:
#   chmod 600 .env

# --- Infrastructure credentials (compose-managed services) ---
# Seed the Postgres + MinIO containers on first boot. Change all of these
# for any deploy touching real data — shared defaults are a common breach path.
POSTGRES_USER=docgen
POSTGRES_PASSWORD=change-me
POSTGRES_DB=docgen
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me

# Host port the web service is exposed on. Compose maps this to container :8000.
# When fronting with a reverse proxy, keep it bound to loopback in your host
# firewall so only the proxy can reach it.
WEB_PORT=8200

# --- Deployment mode ---
# `production` refuses to start without DOCGEN_ADMIN_PASSWORD_HASH and blocks
# dev conveniences (e.g. bootstrap key). Use `development` only for local work.
DOCGEN_ENV=production

# --- App secrets (REQUIRED — no defaults) ---
# HMAC secrets for admin sessions, signed download URLs, and webhook payloads.
# Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# DOCGEN_DOWNLOAD_TOKEN_SECRET is optional — leave blank to fall back to
# DOCGEN_SESSION_SECRET. Set it independently if you want download-URL rotation
# to be independent of admin-session rotation (recommended for prod).
DOCGEN_SESSION_SECRET=
DOCGEN_DOWNLOAD_TOKEN_SECRET=
DOCGEN_WEBHOOK_SIGNING_SECRET=

# --- Admin portal (/ui) ---
# REQUIRED in production (startup fails otherwise). Generate the hash with:
#   python -m docgen.auth hash-password <plaintext>
DOCGEN_ADMIN_USER=admin
DOCGEN_ADMIN_PASSWORD_HASH=

# --- Reverse-proxy / TLS-termination posture ---
# Turn these on when running behind an HTTPS proxy (nginx, caddy, traefik,
# cloudflare, etc.) so cookies get Secure + HSTS ships, even though the app
# itself sees http:// on the wire.
DOCGEN_SECURE_COOKIES=true
DOCGEN_HSTS_ENABLED=true
# Comma-separated IPs / CIDRs whose X-Forwarded-For header we trust. Empty
# (default) = never trust XFF, always use the direct peer. Set to your
# proxy's egress range when behind one — otherwise callers can spoof their
# source IP for rate limiting and audit logs.
DOCGEN_TRUSTED_PROXIES=

# --- Public URL surface (for MCP) ---
# Public scheme+FQDN this deploy is reachable at, no trailing slash.
# Used to render clickable download URLs in MCP responses. These URLs embed
# a short-lived HMAC token in the `?token=` query string — treat them as
# bearer credentials for the lifetime of the token (default: 15 minutes).
# If you front the app with nginx/caddy/traefik, configure the access log
# to redact the `token` query param so it never lands on disk:
#   nginx:  set $safe_query $args; if ($args ~* "^(.*)(token=[^&]*)(.*)$") { set $safe_query "$1token=REDACTED$3"; }
#   caddy:  log { format filter { query { replace token REDACTED } } }
# Empty = tools return relative paths only.
DOCGEN_PUBLIC_BASE_URL=
# Comma-separated Host allowlist for the MCP transport (DNS-rebinding
# protection). Default = localhost only, which returns 421 for any public
# hostname. Set to your FQDN(s) when serving MCP behind a proxy.
DOCGEN_MCP_ALLOWED_HOSTS=

# --- AI provider (design-time only; never called at render time) ---
# stub          deterministic, no network. Bracketed [PLACEHOLDERS] → jinja.
# nebius        NVIDIA Nemotron on Nebius Token Factory (hackathon default).
# openai_compat any OpenAI-compatible endpoint (Azure OpenAI, self-hosted, …).
#
# For the hackathon-hosted demo, use `nebius`:
#   1. Create a Nebius Token Factory API key at https://studio.nebius.com/
#   2. Set DOCGEN_AI_PROVIDER=nebius and DOCGEN_AI_API_KEY=<your key>
#   3. Leave DOCGEN_AI_BASE_URL / DOCGEN_AI_MODEL blank to accept the built-in
#      defaults (Nebius Token Factory + a current Nemotron model). Override
#      DOCGEN_AI_MODEL if you want to A/B a different Nemotron variant.
DOCGEN_AI_PROVIDER=nebius
DOCGEN_AI_BASE_URL=
DOCGEN_AI_API_KEY=
DOCGEN_AI_MODEL=

# --- Design-time preflight backend ---
# Where field-detection + AI mapping runs when a template is uploaded.
#   inline      — in-process, same worker as the request (default; simplest).
#   subprocess  — shell out to the standalone preflight_job CLI. Same
#                 contract as the Nebius Serverless Job container image,
#                 so this is a local proxy for the hosted flow.
#   nebius_job  — submit to Nebius Serverless Jobs. NOT YET IMPLEMENTED;
#                 selecting it fails fast at startup instead of falling back.
DOCGEN_PREFLIGHT_BACKEND=inline
# Wall-clock cap on the subprocess/nebius_job backend, in seconds.
DOCGEN_PREFLIGHT_SUBPROCESS_TIMEOUT_SECONDS=300

# --- Placement Editor PDF field labeler (AI Label / AI Realign) ---
# The PDF placement editor detects fillable regions from PDF geometry
# (pymupdf — no model call) and then labels each region from the page's
# printed captions using a text-only NVIDIA Nemotron reasoning model on
# Nebius Token Factory. Reuses DOCGEN_AI_API_KEY + DOCGEN_AI_BASE_URL;
# the labeler no-ops when DOCGEN_AI_PROVIDER != nebius or the key is
# empty. Override the model here (default: Nemotron-3-Super, chosen for
# reliable one-shot JSON output).
DOCGEN_PDF_LABELER_MODEL=nvidia/nemotron-3-super-120b-a12b

# --- Rate limits (per tenant) ---
DOCGEN_RATE_LIMIT_RENDERS_PER_MINUTE=60
DOCGEN_RATE_LIMIT_UPLOADS_PER_HOUR=60

# --- Dev conveniences (do NOT enable in production) ---
# Auto-mint an API key for the default tenant on first boot; the raw key is
# printed to stderr once. Refused unless DOCGEN_ENV=development.
DOCGEN_BOOTSTRAP_KEY=false

# --- Inbox agent (business stakeholders email templates in) ---
# When enabled, a worker-side poller connects to an IMAP mailbox, ingests
# any new .docx/.pdf attachment, runs the design-time pipeline (upload →
# field detect → mapping → test render), and replies to the sender with
# the results. Per-tenant knobs (sender allow-list, auto-publish threshold,
# extra notify addresses) live in `tenants.inbound_config` — set them via
# the admin portal or a seed script.
#
# For a demo, point IMAP + SMTP at a single-purpose mailbox created just
# for this — e.g. a fresh mailbox on any provider (an app-specific
# password beats OAuth for a demo). Never use a shared or personal inbox.
#
# Demo mailbox for this build: quire.template.agent@gmail.com
#   IMAP: imap.gmail.com:993 (SSL)
#   SMTP: smtp.gmail.com:587 (STARTTLS)
#   Auth: 16-char app-password (Google Account → Security → App passwords).
#         The account itself uses 2FA; the app password bypasses 2FA for
#         this connection only. Do NOT use the primary account password.
DOCGEN_INBOX_ENABLED=false
DOCGEN_INBOX_IMAP_HOST=imap.gmail.com
DOCGEN_INBOX_IMAP_PORT=993
DOCGEN_INBOX_USERNAME=quire.template.agent@gmail.com
DOCGEN_INBOX_PASSWORD=
DOCGEN_INBOX_MAILBOX=INBOX
DOCGEN_INBOX_POLL_INTERVAL_SECONDS=60
DOCGEN_INBOX_MAX_ATTACHMENT_BYTES=20971520

DOCGEN_SMTP_HOST=smtp.gmail.com
DOCGEN_SMTP_PORT=587
DOCGEN_SMTP_USERNAME=quire.template.agent@gmail.com
DOCGEN_SMTP_PASSWORD=
DOCGEN_SMTP_FROM=quire.template.agent@gmail.com
DOCGEN_SMTP_USE_STARTTLS=true

# Base URL used to build the "Review in admin portal" deep-link in replies.
# Usually the same as DOCGEN_PUBLIC_BASE_URL.
DOCGEN_ADMIN_BASE_URL=

# --- Bring-up ---
# docker compose -f deploy/docker-compose.prod.yml --env-file .env up -d
# → the `migrate` sidecar runs `alembic upgrade head`, then web + worker start.
# REST:  http(s)://<host>:${WEB_PORT}/docs
# MCP:   http(s)://<host>:${WEB_PORT}/mcp/
