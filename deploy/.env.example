# Copy to .env at the repo root on the Mac (chmod 600).
# Do NOT commit .env — only this example belongs in git.

# --- Public exposure ----------------------------------------------------------
# Host port for the web container. Cloudflare Tunnel target is http://localhost:$WEB_PORT.
WEB_PORT=8200

# --- Postgres -----------------------------------------------------------------
POSTGRES_USER=docgen
POSTGRES_PASSWORD=change-me
POSTGRES_DB=docgen

# --- MinIO --------------------------------------------------------------------
MINIO_ROOT_USER=docgen-minio
MINIO_ROOT_PASSWORD=change-me

# --- DocGen app secrets -------------------------------------------------------
# Deployment mode. Any value other than "development" enables production
# checks (refuses startup on empty admin-hash / secrets). Default is
# "production" if unset, but being explicit here avoids surprises.
DOCGEN_ENV=production

# Rotate before real traffic. Both REQUIRED (startup fails cleanly if unset).
# Generate each with: openssl rand -hex 32
DOCGEN_SESSION_SECRET=
DOCGEN_WEBHOOK_SIGNING_SECRET=

# Admin username (defaults to "admin" if unset).
DOCGEN_ADMIN_USER=admin

# Bcrypt hash of the admin password. REQUIRED in production. Generate inside
# the web container:
#   docker compose -p quire -f deploy/docker-compose.prod.yml exec web python -c \
#     "from docgen.auth import hash_password; print(hash_password('YourPassword'))"
DOCGEN_ADMIN_PASSWORD_HASH=

# --- AI provider (design-time only; render path is deterministic) ------------
# For the hackathon deploy on Nebius AI Cloud, use `nebius`:
#   DOCGEN_AI_PROVIDER=nebius
#   DOCGEN_AI_API_KEY=<your Nebius Token Factory key>
# Leave BASE_URL and MODEL blank to accept the built-in Nebius Token Factory /
# Nemotron defaults. Set DOCGEN_AI_PROVIDER=stub to run without any external
# model (deterministic placeholder detection only).
DOCGEN_AI_PROVIDER=nebius
DOCGEN_AI_BASE_URL=
DOCGEN_AI_API_KEY=
DOCGEN_AI_MODEL=

# --- Placement Editor PDF field labeler (AI Label / AI Realign) --------------
# Detection is deterministic PDF geometry (pymupdf — no model call). Labeling
# uses a text-only NVIDIA Nemotron reasoning model on Nebius Token Factory,
# reusing DOCGEN_AI_API_KEY above. Override to A/B a different Nemotron
# variant; the default is chosen for reliable one-shot JSON output.
DOCGEN_PDF_LABELER_MODEL=nvidia/nemotron-3-super-120b-a12b
